{
  "name": "LocalFind - Hyperlocal Store Window",
  "short_name": "LocalFind",
  "description": "Discover live products in nearby local shops within a 2 km radius. 0% commission direct WhatsApp buying.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "background_color": "#fff8f6",
  "theme_color": "#9c3e20",
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "en",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Nearby Deals",
      "short_name": "Deals",
      "description": "Browse live flash deals and local shops near you",
      "url": "/?view=discover",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Merchant Dashboard",
      "short_name": "My Shop",
      "description": "Manage products, flash deals, and store settings",
      "url": "/?view=merchant",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["shopping", "lifestyle", "business", "utilities"]
}
